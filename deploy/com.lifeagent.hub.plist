<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  常驻运行（常开的 Mac）：
    1. 把下面的 /path/to/life-agent 改成仓库绝对路径
    2. cp deploy/com.lifeagent.hub.plist ~/Library/LaunchAgents/
    3. launchctl load -w ~/Library/LaunchAgents/com.lifeagent.hub.plist
  用 LaunchAgent（用户会话）而不是 LaunchDaemon：lark-cli 的登录态、钥匙串、
  微信数据目录都在当前用户下。
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lifeagent.hub</string>
  <key>WorkingDirectory</key><string>/path/to/life-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/life-agent/bin/lifeagent</string>
    <string>-config</string><string>/path/to/life-agent/config.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- 把 YOU 换成你的用户名：Claude Code 原生安装在 ~/.local/bin，launchd 不会展开 ~ -->
    <key>PATH</key><string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/lifeagent.log</string>
  <key>StandardErrorPath</key><string>/tmp/lifeagent.log</string>
</dict>
</plist>
